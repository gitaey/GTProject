{
    "compilerOptions": {
        "target": "ES2019",
        "lib": ["dom", "dom.iterable", "es2020"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["src"]
}
